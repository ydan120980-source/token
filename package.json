{
  "name": "agent-usage",
  "productName": "Agent Usage Quota",
  "version": "0.1.1",
  "description": "Windows-local usage statistics for ten AI coding agents, provider-reported quota and explicit local configuration management",
  "main": "src/quota/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test tests/m1/*.test.js",
    "lint": "eslint src/m1 src/quota scripts/m1 tests/m1 design/desktop-reference",
    "typecheck:ui": "tsc -p ui/tsconfig.json",
    "build:ui": "vite build --config ui/vite.config.ts",
    "verify": "npm run lint && npm run typecheck:ui && npm test",
    "test:ui": "node scripts/m1/usage-ui-test.js",
    "test:custom:ui": "node scripts/m1/custom-sources-ui-test.js",
    "test:workbench:ui": "node scripts/m1/workbench-ui-test.js",
    "test:workbench:stress": "node scripts/m1/workbench-stress-test.js",
    "test:custom:stress": "node scripts/m1/custom-sources-stress-test.js",
    "test:native": "node scripts/m1/native-test.js",
    "experiment:crypto": "node scripts/m1/crypto-experiment.js",
    "test:stress": "node scripts/m1/stress-test.js",
    "test:stress:ui": "node scripts/m1/ui-stress-test.js",
    "audit:runtime": "node scripts/m1/audit-runtime.js",
    "audit:package": "node scripts/m1/audit-package.js",
    "governance": "node scripts/m1/governance.js",
    "validate:local": "node scripts/m1/validate-local.js",
    "dist:win:dir": "node scripts/m1/check-build-deps.js && electron-builder --win dir --x64 --publish never",
    "candidate:plan": "node scripts/m1/local-candidate.js plan",
    "candidate:build": "node scripts/m1/local-candidate.js build",
    "candidate:check": "node scripts/m1/local-candidate.js check",
    "signing:plan": "node scripts/m1/signing-profile.js --plan",
    "dist:share": "node scripts/m1/dist-share.js",
    "dist:share:verify": "node scripts/m1/dist-share.js --verify",
    "package:source": "node scripts/m1/source-archive.js",
    "start:quota": "electron .",
    "test:quota:ui": "node scripts/m1/quota-ui-test.js",
    "test:visual:ui": "node scripts/m1/visual-ui-test.js",
    "test:activity:ui": "node scripts/m1/activity-ui-test.js",
    "dist:quota:win": "npm run dist:win:dir",
    "test:motion:ui": "node scripts/m1/motion-ui-test.js",
    "test:detail:ui": "node scripts/m1/detail-ui-test.js",
    "test:polish:ui": "node scripts/m1/polish-ui-test.js",
    "test:desktop:performance": "node scripts/m1/desktop-performance-test.js",
    "test:performance": "node scripts/m1/performance-benchmark.js",
    "test:functional:ui": "node scripts/m1/functional-ui-test.js",
    "test:layout:ui": "node scripts/m1/layout-ui-test.js",
    "test:sessions:ui": "node scripts/m1/sessions-ui-test.js",
    "pricing:sync": "node scripts/m1/pricing-sync.js",
    "pricing:check": "node scripts/m1/pricing-sync.js --check",
    "pricing:sync:remote": "node scripts/m1/pricing-fetch-task.js --now",
    "pricing:sync:check": "node scripts/m1/pricing-fetch-task.js --check",
    "query:saved": "node src/m1/query-entry.js query",
    "mcp:saved": "node src/m1/query-entry.js mcp",
    "test:query:integration": "node scripts/m1/query-integration-test.js",
    "test:ui:foundation": "node scripts/m1/ui-foundation-ui-test.js",
    "dist:win:setup": "node scripts/m1/check-build-deps.js && electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "local.agentusage.quota",
    "productName": "Agent Usage Quota",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/quota/**/*",
      "src/m1/**/*.js",
      "!src/m1/crypto.js",
      "src/m1/prices.json",
      "src/m1/models-dev-prices.json",
      "src/m1/MODELS-DEV-LICENSE.txt",
      "design/desktop-reference/**/*",
      "!design/desktop-reference/serve.js",
      "!design/desktop-reference/README.md",
      "assets/icon-win.png",
      "package.json",
      "LICENSE",
      "docs/m1/UPSTREAM.md",
      "docs/m1/CODEX-QUOTA.md"
    ],
    "asarUnpack": [
      "src/quota/claude-statusline-export.ps1",
      "src/quota/windows-job-host.ps1",
      "src/quota/windows-job-host.cs",
      "src/quota/agent-install-host.ps1",
      "node_modules/@tokscale/**/*",
      "node_modules/tokscale/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon-win.png",
      "signAndEditExecutable": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ydan120980-source",
        "repo": "token"
      }
    ],
    "npmRebuild": false,
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": true,
      "artifactName": "AgentUsage-${version}-preview-setup.${ext}"
    }
  },
  "keywords": [
    "tokscale",
    "claude-code",
    "codex",
    "opencode",
    "workbuddy",
    "mimocode",
    "gemini-cli",
    "cursor",
    "zcode",
    "deepseek-harness",
    "token-usage",
    "cost-tracking",
    "llm",
    "ai-tools",
    "electron",
    "desktop-widget",
    "local-first",
    "self-hosted"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ydan120980-source/token.git"
  },
  "homepage": "https://github.com/ydan120980-source/token#readme",
  "bugs": {
    "url": "https://github.com/ydan120980-source/token/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "electron-updater": "^6.8.11",
    "sql.js": "1.14.2",
    "tokscale": "4.17.0"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-scroll-area": "1.2.11",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@tabler/icons-react": "3.41.1",
    "@tailwindcss/vite": "4.1.18",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "43.4.0",
    "electron-builder": "26.16.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "lucide-react": "0.564.0",
    "motion": "14.1.0",
    "playwright": "1.63.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "3.4.0",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "private": true,
  "author": "Agent Usage contributors"
}
