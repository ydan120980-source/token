{
  "name": "agent-usage",
  "productName": "Agent Usage Quota",
  "version": "0.1.0",
  "description": "Private Windows local usage and Codex account quota",
  "main": "src/quota/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test tests/m1/*.test.js",
    "lint": "eslint src/m1 src/quota scripts/m1 tests/m1 design/desktop-reference",
    "verify": "npm run lint && npm test",
    "test:ui": "node scripts/m1/usage-ui-test.js",
    "test:native": "node scripts/m1/native-test.js",
    "experiment:crypto": "node scripts/m1/crypto-experiment.js",
    "test:stress": "node scripts/m1/stress-test.js",
    "test:stress:ui": "node scripts/m1/ui-stress-test.js",
    "audit:runtime": "node scripts/m1/audit-runtime.js",
    "audit:package": "node scripts/m1/audit-package.js",
    "governance": "node scripts/m1/governance.js",
    "validate:local": "node scripts/m1/validate-local.js",
    "dist:win:dir": "electron-builder --win dir --x64 --publish never",
    "dist:share": "node scripts/m1/dist-share.js",
    "dist:share:verify": "node scripts/m1/dist-share.js --verify",
    "package:source": "node scripts/m1/source-archive.js",
    "start:quota": "electron .",
    "test:quota:ui": "node scripts/m1/quota-ui-test.js",
    "test:visual:ui": "node scripts/m1/visual-ui-test.js",
    "test:activity:ui": "node scripts/m1/activity-ui-test.js",
    "dist:quota:win": "npm run dist:win:dir",
    "test:motion:ui": "node scripts/m1/motion-ui-test.js",
    "test:detail:ui": "node scripts/m1/detail-ui-test.js",
    "test:polish:ui": "node scripts/m1/polish-ui-test.js",
    "test:desktop:performance": "node scripts/m1/desktop-performance-test.js",
    "test:functional:ui": "node scripts/m1/functional-ui-test.js",
    "pricing:sync": "node scripts/m1/pricing-sync.js",
    "pricing:check": "node scripts/m1/pricing-sync.js --check"
  },
  "build": {
    "appId": "local.agentusage.quota",
    "productName": "Agent Usage Quota",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/quota/**/*",
      "src/m1/**/*.js",
      "!src/m1/crypto.js",
      "!src/m1/read-snapshot.js",
      "src/m1/prices.json",
      "src/m1/models-dev-prices.json",
      "src/m1/MODELS-DEV-LICENSE.txt",
      "design/desktop-reference/**/*",
      "!design/desktop-reference/serve.js",
      "!design/desktop-reference/README.md",
      "assets/icon-win.png",
      "package.json",
      "LICENSE",
      "docs/m1/UPSTREAM.md",
      "docs/m1/CODEX-QUOTA.md"
    ],
    "asarUnpack": [
      "node_modules/@tokscale/**/*",
      "node_modules/tokscale/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon-win.png",
      "signAndEditExecutable": false
    },
    "publish": null,
    "npmRebuild": false
  },
  "keywords": [
    "tokscale",
    "claude-code",
    "codex",
    "hermes",
    "token-monitor",
    "token-usage",
    "cost-tracking",
    "llm",
    "ai-tools",
    "electron",
    "desktop-widget",
    "local-first",
    "self-hosted"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Javis603/token-monitor.git"
  },
  "homepage": "https://github.com/Javis603/token-monitor#readme",
  "bugs": {
    "url": "https://github.com/Javis603/token-monitor/issues"
  },
  "dependencies": {
    "sql.js": "1.14.2",
    "tokscale": "4.17.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "electron": "43.4.0",
    "electron-builder": "26.16.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "playwright": "1.63.0"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "private": true,
  "author": "Agent Usage M1 local project"
}
