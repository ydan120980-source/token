{
  "name": "agent-usage-m1",
  "productName": "Agent Usage M1",
  "version": "0.1.0",
  "description": "Private local agent usage statistics",
  "main": "src/m1/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test tests/m1/*.test.js",
    "test:upstream": "node --test tests/shared/usageDelta.test.js tests/shared/historyDayBoundary.test.js tests/shared/archiveHelpers.test.js tests/shared/tokscaleClientMapping.test.js",
    "lint": "eslint src/m1 scripts/m1 tests/m1",
    "verify": "npm run lint && npm test",
    "test:ui": "node scripts/m1/ui-test.js",
    "test:native": "node scripts/m1/native-test.js",
    "experiment:crypto": "node scripts/m1/crypto-experiment.js",
    "validate:local": "node scripts/m1/validate-local.js",
    "dist:win:dir": "electron-builder --win dir --x64 --publish never",
    "package:source": "node scripts/m1/source-archive.js"
  },
  "build": {
    "appId": "local.agentusage.desktop.m1",
    "productName": "Agent Usage M1",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/m1/**/*",
      "src/electron/renderer/styles.css",
      "assets/icon-win.png",
      "assets/icons/**/*",
      "package.json",
      "LICENSE",
      "docs/m1/UPSTREAM.md"
    ],
    "asarUnpack": [
      "node_modules/@tokscale/**/*",
      "node_modules/tokscale/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon-win.png",
      "signAndEditExecutable": false
    },
    "publish": null,
    "npmRebuild": false
  },
  "keywords": [
    "tokscale",
    "claude-code",
    "codex",
    "hermes",
    "token-monitor",
    "token-usage",
    "cost-tracking",
    "llm",
    "ai-tools",
    "electron",
    "desktop-widget",
    "local-first",
    "self-hosted"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Javis603/token-monitor.git"
  },
  "homepage": "https://github.com/Javis603/token-monitor#readme",
  "bugs": {
    "url": "https://github.com/Javis603/token-monitor/issues"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4",
    "chokidar": "^4.0.3",
    "dotenv": "^17.4.2",
    "electron-updater": "6.8.9",
    "koffi": "^3.1.5",
    "semver": "^7.8.5",
    "sql.js": "1.14.2",
    "tar": "^7.5.22",
    "tokscale": "4.17.0",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@electron/osx-sign": "1.3.3",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "electron": "43.4.0",
    "electron-builder": "26.16.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "playwright": "1.63.0"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "private": true,
  "author": "Agent Usage M1 local project"
}
